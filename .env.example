# Cleaning Ops — copy to .env.local and fill in real values.
# Supabase project: Cleaning Dashboard (ref lijsaulkeaqlriwqgxty). Never the
# archived MAKI project (dpmgeqxwufqcwboprckw).

# Supabase project API URL (Project Settings -> Data API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://lijsaulkeaqlriwqgxty.supabase.co

# Supabase publishable key (Project Settings -> API Keys). Safe in the browser; RLS enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (Project Settings -> API Keys). SERVER-ONLY: bypasses RLS.
# Used by webhooks, cron and the scripts in scripts/. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secrets read by src/lib/webhook-auth.ts. Generate each with: openssl rand -hex 32
# Prefer provider signature verification for new webhooks (CLAUDE.md rule 1).
N8N_WEBHOOK_SECRET=
RETELL_WEBHOOK_SECRET=
# Vercel Cron sends this back as "authorization: Bearer <value>". Set the same value in Vercel.
CRON_SECRET=

# Stripe, TEST MODE ONLY for now (a live key is refused in code). Dashboard -> Developers -> API keys.
# SERVER-ONLY. Never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <app url>/api/webhooks/stripe (events:
# checkout.session.completed, payment_intent.succeeded, refund.created, refund.updated).
# Dashboard -> Developers -> Webhooks, or `stripe listen` for local testing.
STRIPE_WEBHOOK_SECRET=
# Public base URL of this app, used for Stripe return links and pay links, e.g. https://app.example.com
NEXT_PUBLIC_APP_URL=

# Bearer key for GET /api/growth/snapshot, the read-only growth numbers that Roast Room, Agents and the voice AI poll.
# Generate with: openssl rand -hex 32. SERVER-ONLY. It can read the snapshot and nothing else.
GROWTH_API_KEY=

# GoHighLevel: a SEPARATE sub-account for this business (never the MAKI one). All SERVER-ONLY.
# Location ID: GHL -> Settings -> Business Profile (or the id in the sub-account URL).
GHL_LOCATION_ID=
# Private Integration token: GHL -> Settings -> Private Integrations. Scopes: contacts, conversations and
# conversations/message, opportunities, calendars/events (read and write where it sends or updates).
GHL_API_TOKEN=
# Shared secret the GHL workflows send in the x-ghl-webhook-secret header. At least 32 characters.
# Generate with: openssl rand -hex 32
GHL_WEBHOOK_SECRET=
# Tests only: point the GHL client at a fake GHL on this machine (http://127.0.0.1:<port> or localhost). Any other value is ignored.
# GHL_API_BASE=

# Public lead form (/lead-form, POST /api/public/leads). All SERVER-ONLY except the Turnstile site key,
# which is public by design. The form refuses to run in production until the first three are set.
# Cloudflare Turnstile: dash.cloudflare.com -> Turnstile -> add a widget for your site's domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Keys the hash of visitor addresses used for rate limits and stored consent evidence. At least 16 characters.
# Generate with: openssl rand -hex 32
INTAKE_IP_SALT=
# Optional: space-separated origins allowed to frame the form, e.g. https://www.example.com https://example.com. Empty means any site.
INTAKE_EMBED_ORIGINS=
# Tests only: point the Turnstile check at a fake on this machine (http://127.0.0.1:<port> or localhost). Any other value is ignored.
# TURNSTILE_VERIFY_URL=

# AI (callModel, src/lib/ai). Two keys for THIS app only, SERVER-ONLY, never NEXT_PUBLIC_. Do NOT reuse the older
# ANTHROPIC_API_KEY in .env.local (it belongs to MAKI). Also set a monthly spend limit on each provider as a backstop:
# Anthropic Console -> Settings -> Limits (use a workspace just for this app); xAI Console -> Billing -> spend limit.
CLEANING_ANTHROPIC_API_KEY=
XAI_API_KEY=
# Tests only: point the providers at fakes on this machine (http://127.0.0.1:<port> or localhost). Any other value is ignored.
# AI_ANTHROPIC_BASE=
# AI_XAI_BASE=

# Demo mode for the sample analytics panels. Leave empty on real deployments. Set to 1 only
# while seeded demo rows (ids starting 5eed0000-) are loaded; the panels vanish with the purge.
DEMO_ANALYTICS=
