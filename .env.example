# MAKI Ops — copy to .env.local and fill in real values.

# Supabase project API URL (Project Settings -> Data API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable / anon key (Project Settings -> API Keys)
# This is safe to expose to the browser. NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Shared secret guarding the appointment-booked webhook.
# Generate with: openssl rand -hex 32
# Paste the same value into n8n's HTTP Request node header `x-webhook-secret`.
N8N_WEBHOOK_SECRET=change-me

# Supabase service_role key — server-only, used ONLY by the appointment-booked
# webhook route (no user session, must bypass RLS). Never exposed to the browser.
# Supabase dashboard -> Project Settings -> API Keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only, powers the /insights AI query page.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Monthly /insights query cap, per logged-in user. One shared API key pays
# for every query from every user, so this bounds the bill. Optional —
# defaults to 50 if unset.
INSIGHTS_MONTHLY_QUERY_CAP=50

# GHL Private Integration Token — server-only, lets MAKI Ops send actions
# (e.g. SMS) to GHL instead of just receiving webhooks.
# GHL -> Settings -> Private Integrations -> Create New Integration.
# Requires scope: conversations/message.write
GHL_API_TOKEN=

# Meta Marketing API — server-only, powers the "Sync Meta spend" button.
# System User access token (Business Manager -> System Users -> Generate Token)
# with the ads_read scope. Graph API version pinned in src/lib/meta.ts (v25.0).
META_ACCESS_TOKEN=
# Numeric ad account ID, WITHOUT the "act_" prefix (added in code).
META_AD_ACCOUNT_ID=

# Phones allowed to text the /insights AI via /api/insights/sms. JSON array
# of {phone, email} — email must match a real Supabase Auth user.
# Example: [{"phone":"+15551234567","email":"you@example.com"}]
INSIGHTS_SMS_ALLOWLIST=

# Retell voice agent ("ask_maki_ops" custom function) -> /api/retell/query-insights.
# Generate with: openssl rand -hex 32
# Paste the same value into Retell's custom function Headers field as x-retell-secret.
RETELL_WEBHOOK_SECRET=

# Phase 1 voice allowlist — only this number gets real answers on a call.
# Must match a phone entry in INSIGHTS_SMS_ALLOWLIST above (reused to resolve
# which Supabase user the call's usage counts against).
MY_PHONE_NUMBER=

# How many days after an appointment's scheduled date to send the
# job-closed follow-up SMS (/api/webhooks/job-followup-send). Optional —
# defaults to 2 if unset.
JOB_FOLLOWUP_DELAY_DAYS=2

# Lead response monitoring (Phase 2) — how long a lead can sit at status
# 'new' (uncontacted) before it's flagged as a warning, then critical/"ghost
# lead". Optional — default to 30 minutes and 24 hours.
LEAD_RESPONSE_WARNING_MINUTES=30
LEAD_RESPONSE_CRITICAL_HOURS=24

# Dev-only convenience: credentials for the /dev-login route, which signs you
# in automatically so you can open the app already authenticated locally.
# NOT required in production — the route returns 404 when NODE_ENV=production.
# Leave blank if you don't want this shortcut; use /login instead.
MAKI_LOGIN_EMAIL=
MAKI_LOGIN_PASSWORD=
